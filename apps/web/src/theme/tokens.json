    "ml": "\"Noto Sans Malayalam Variable\", \"Inter Variable\", system-ui, sans-serif"
  },
  "textScale": {
    "$comment": "Root font size per user text-size setting. 1rem = 17px at normal.",
    "normal": "106.25%",
