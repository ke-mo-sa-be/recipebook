# ─────────────────────────────────────────────────────────────────────────────
# Recipebook environment variables. Copy to `.env` (repo root) and fill in.
# Real env files are gitignored. Never commit real values.
#
# Two consumers read this:
#   • Vite (apps/web)        — only VITE_* variables, and they are PUBLIC (shipped to browsers).
#   • Supabase CLI (local)   — reads supabase/.env for env(...) values in supabase/config.toml.
#     Copy the server-side values below into supabase/.env (also gitignored).
# Production (self-hosted) variables for the upstream Supabase compose are documented in
# SELF_HOSTING.md and deploy/compose/.env.example (M8).
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (browser) ─────────────────────────────────────────────────────────
# API base. Local: http://<host>:54321 from `supabase status`. Production: your site origin
# (Traefik routes /auth/v1, /rest/v1, … on the same host).
VITE_SUPABASE_URL=http://localhost:54321
# Publishable ("anon") key from `supabase status`. Safe to expose; RLS protects data.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Where the app is served. Used for auth redirects and share links.
VITE_SITE_URL=http://localhost:5173
# Public URL of the auth API, used in email links and OAuth callbacks. Local: http://127.0.0.1:54321/auth/v1
# Behind a proxy (staging/production): <site origin>/auth/v1
AUTH_EXTERNAL_URL=http://127.0.0.1:54321/auth/v1
# Cloudflare Turnstile site key (M6). Test key that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# ── Server-side only (Supabase CLI / Edge Functions) — NEVER prefix with VITE_ ──
# Must equal VITE_SITE_URL. Used in auth emails and as the redirect allow-list.
SITE_URL=http://localhost:5173

# Google sign-in (M1). Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <VITE_SUPABASE_URL>/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Transactional email (production / staging). Keep SMTP_ENABLED=false for local dev and E2E: mail then goes
# to the built-in test inbox (http://127.0.0.1:54324). Any SMTP provider works, e.g. Brevo, or Gmail
# (smtp.gmail.com, port 587, the account address as user, and a Google app password as SMTP_PASS).
SMTP_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@example.org
SMTP_SENDER_NAME=Paachakam

# Web push (M4). Leave empty and push stays off (the app hides the option). Create a pair with:
#   deno eval 'import w from "npm:web-push@3.6.7"; console.log(w.generateVAPIDKeys())'
# The subject is a mailto: or https: contact for push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Cloudflare Turnstile secret (M6). Test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
