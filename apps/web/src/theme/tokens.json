  "contrast": {
    "$comment": "[foreground, background, minimum ratio]. 4.5 = WCAG AA body text; 3 = large text (text-soft is only for text ≥ 24px, e.g. the grey second line of headlines), UI components, focus rings.",
    "pairs": [
      ["text", "bg", 4.5],
      ["text", "surface", 4.5],
      ["text", "surface-sunken", 4.5],
      ["text-muted", "bg", 4.5],
      ["text-muted", "surface", 4.5],
      ["text-muted", "surface-sunken", 4.5],
      ["text-soft", "surface", 3],
      ["text-soft", "bg", 3],
      ["on-primary", "primary", 4.5],
      ["on-primary", "primary-hover", 4.5],
      ["on-primary-soft", "primary-soft", 4.5],
      ["accent", "surface", 4.5],
      ["accent", "bg", 4.5],
      ["on-accent", "accent", 4.5],
      ["on-accent-soft", "accent-soft", 4.5],
      ["leaf", "surface", 4.5],
      ["on-leaf", "leaf", 4.5],
      ["on-leaf-soft", "leaf-soft", 4.5],
      ["warning", "surface", 4.5],
      ["on-warning-soft", "warning-soft", 4.5],
      ["danger", "surface", 4.5],
      ["danger", "bg", 4.5],
      ["on-danger", "danger", 4.5],
      ["on-danger-soft", "danger-soft", 4.5],
      ["border-strong", "surface", 3],
      ["border-strong", "bg", 3],
      ["primary", "bg", 3],
      ["primary", "surface", 3],
      ["focus", "bg", 3],
      ["focus", "surface", 3],
      ["diet-veg", "surface", 3],
      ["diet-egg", "surface", 3],
      ["diet-nonveg", "surface", 3]
    ]
